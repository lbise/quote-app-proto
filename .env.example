# Local PostgreSQL connection used by migrations and the readiness endpoint.
DATABASE_URL=postgresql://easy_quote@localhost:55432/easy_quote_local

# Authentication. Use a long random value in deployment (never commit the real value).
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
# Space, comma or newline separated approved tester email addresses.
# '*' is convenient for disposable local development only.
AUTH_ALLOWED_EMAILS=*
# Optional additional origins, separated by spaces.
AUTH_TRUSTED_ORIGINS=http://localhost:5173 https://dev.voidstation.ch

# fake captures auth email messages in memory and is the local default.
# Set smtp only in a deployment that has the dedicated mailbox configured.
EMAIL_DELIVERY=fake
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=auth@voidstation.ch
SMTP_PASSWORD=replace-with-a-dedicated-device-password
SMTP_FROM=auth@voidstation.ch

# Quote AI is always available. Never commit the real API key.
# Data in assistant messages and permitted Quote work is sent to the configured provider.
QUOTE_AI_PROVIDER=google
QUOTE_AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-with-a-gemini-api-key
# Reasoning level: off, minimal, low, medium, high, xhigh or max, if the model supports it.
# Gemini 3.5 Flash-Lite cannot turn reasoning off, so it needs an explicit level.
QUOTE_AI_REASONING=minimal
# Optional output-token limit per model call (default 4096, at most the model's limit).
# QUOTE_AI_MAX_OUTPUT_TOKENS=4096
# OpenRouter alternative (see docs/quote-ai.md; real data is not approved yet, #38):
# QUOTE_AI_PROVIDER=openrouter
# QUOTE_AI_MODEL=author/model
# QUOTE_AI_SPEND_LIMIT_USD=5
# The evaluator also uses this key for OpenRouter model discovery and bounded sessions.
# OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
# Optional whole-turn deadline in milliseconds. Valid range: 1000 through 45000.
QUOTE_AI_TIMEOUT_MS=20000
# Optional: expose tool calls (successful and failed) and LLM diagnostics in the Quote UI. Dev only.
# QUOTE_AI_DEBUG=true
