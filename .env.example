# Local PostgreSQL connection used by migrations and the readiness endpoint.
DATABASE_URL=postgresql://easy_quote@localhost:55432/easy_quote_local

# Authentication. Use a long random value in deployment (never commit the real value).
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
# Space, comma or newline separated approved tester email addresses.
# '*' is convenient for disposable local development only.
AUTH_ALLOWED_EMAILS=*
# Optional additional origins, separated by spaces.
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# fake captures auth email messages in memory and is the local default.
# Set smtp only in a deployment that has the dedicated mailbox configured.
EMAIL_DELIVERY=fake
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=auth@voidstation.ch
SMTP_PASSWORD=replace-with-a-dedicated-device-password
SMTP_FROM=auth@voidstation.ch

# Hosted Quote AI stays disabled until the OpenAI privacy review in docs/quote-ai.md is complete.
# Never commit a real API key. Live tester data must not be sent before that review.
QUOTE_AI_ENABLED=false
QUOTE_AI_NO_TRAINING_CONFIRMED=false
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_MODEL=
# Optional provider-request timeout in milliseconds. Valid range: 1000 through 45000.
QUOTE_AI_TIMEOUT_MS=20000
