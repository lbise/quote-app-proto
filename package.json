{
  "name": "easy-quote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "prototype:quotes": "react-router dev --host 0.0.0.0 --port 5174 --strictPort --open /quote-layout-prototype?variant=A",
    "dev:network": "react-router dev --host 0.0.0.0 --port 5173 --strictPort",
    "dev:user": "tsx scripts/dev-user.ts",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:browser": "./scripts/browser-test.sh",
    "check": "npm run typecheck && npm run test",
    "eval:review": "tsx scripts/eval-review.ts",
    "eval:start": "tsx scripts/eval-start.ts",
    "eval:run": "tsx scripts/evaluate.ts",
    "eval:db": "bash scripts/eval-db.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5",
    "lucide-react": "^1.43.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.3.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.3.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "unpdf": "^1.8.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
