                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 160,
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true,
                "description": "Fields supported by this citation. For edit_quote_details, use field names such as discountMode and discount. For other tools, use JSON Pointers such as /sections/0/title."
              },
              "source": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "description": "Source supplied by the application: current, history_N, quote.FIELD, line:ID.FIELD or section:ID.FIELD. Never cite an assistant message."
              },
              "text": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "description": "Exact excerpt from the identified source. One citation may support several fields."
              }
            },
            "required": [
              "fields",
              "source",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "Cite sources for new nonempty commercial facts. Omit for deliberate clearing or unchanged values."
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "copy_quote_work",
    "description": "Copy up to 50 Quote Lines or one Quote Section with its lines. For line copies, optionally choose a destination section; otherwise copies follow their source lines. For a section copy, supply its title. Set measurementPolicy to retain to keep measurements, or unknown to clear quantities and remove embedded measurements. Other values are retained.",
    "parameters": {
      "type": "object",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lineIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true
                },
                "destinationSectionId": {
                  "type": "string",
                  "maxLength": 128,
                  "description": "Existing Quote Section ID, or the empty string for No section."
                }
              },
              "required": [
                "lineIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "sectionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "title": {
                  "type": "string",
                  "maxLength": 4000,
                  "minLength": 1
                }
              },
              "required": [
                "sectionId",
                "title"
              ],
              "additionalProperties": false
            }
          ]
        },
        "measurementPolicy": {
          "type": "string",
          "enum": [
            "retain",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 160,
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true,
                "description": "Fields supported by this citation. For edit_quote_details, use field names such as discountMode and discount. For other tools, use JSON Pointers such as /sections/0/title."
              },
              "source": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "description": "Source supplied by the application: current, history_N, quote.FIELD, line:ID.FIELD or section:ID.FIELD. Never cite an assistant message."
              },
              "text": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "description": "Exact excerpt from the identified source. One citation may support several fields."
              }
            },
            "required": [
              "fields",
              "source",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "Cite the supplied section title with /source/title when copying a section. Line copies only need evidence when they introduce a new nonempty commercial fact; omit for unchanged values or deliberate clearing."
        }
      },
      "required": [
        "source",
        "measurementPolicy"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_quote_work",
    "description": "Move or reorder up to 50 Quote Lines or Quote Sections. For lines, supply a destination section ID; use an empty string for No section. Supply IDs in the desired order. Use beforeLineId or beforeSectionId to insert before an existing line or section; omit it to append. Do not edit content, copy or delete work with this tool.",
    "parameters": {
      "type": "object",
      "properties": {
        "move": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lineIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true
                },
                "destinationSectionId": {
                  "type": "string",
                  "maxLength": 128,
                  "description": "Existing Quote Section ID, or the empty string for No section."
                },
                "beforeLineId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                }
              },
              "required": [
                "lineIds",
                "destinationSectionId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "sectionIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true
                },
                "beforeSectionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                }
              },
              "required": [
                "sectionIds"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "move"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_quote_lines",
    "description": "Delete up to 50 explicitly identified Quote Lines. Supply their existing IDs. Do not delete Quote Sections or remove all work; direct those requests to the manual controls.",
    "parameters": {
      "type": "object",
      "properties": {
        "lineIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        }
      },
      "required": [
        "lineIds"
      ],
      "additionalProperties": false
    }
  }
]
