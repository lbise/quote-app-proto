              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "True applies the supported standard VAT treatment, false means not registered, null means unknown. Never infer registration."
            },
            "vatId": {
              "type": "string",
              "maxLength": 20000
            },
            "discountMode": {
              "type": "string",
              "enum": [
                "none",
                "percent",
                "fixed"
              ]
            },
            "discount": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^$|^[0-9]+([.,][0-9]+)?$",
              "description": "Decimal without units, or the empty string to deliberately clear the value. Missing is not zero."
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 160,
                "description": "JSON Pointer to the input field supported by this evidence, including its operation index."
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "artisan_message"
                        ]
                      },
                      "messageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                      },
                      "excerpt": {
                        "type": "string",
                        "maxLength": 2000,
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "messageId",
                      "excerpt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "current_work"
                        ]
                      },
                      "entity": {
                        "type": "string",
                        "enum": [
                          "quote"
                        ]
                      },
                      "field": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "excerpt": {
                        "type": "string",
                        "maxLength": 2000,
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "entity",
                      "field",
                      "excerpt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "current_work"
                        ]
                      },
                      "entity": {
                        "type": "string",
                        "enum": [
                          "line",
