      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "maxLength": 200
            },
            "title": {
              "type": "string",
              "maxLength": 20000
            },
            "issueDate": {
              "type": "string",
              "maxLength": 10,
              "description": "YYYY-MM-DD or empty."
            },
            "validUntil": {
              "type": "string",
              "maxLength": 10,
              "description": "YYYY-MM-DD or empty."
            },
            "siteAddress": {
              "type": "string",
              "maxLength": 20000
            },
            "customerName": {
              "type": "string",
              "maxLength": 20000
            },
            "customerAddress": {
              "type": "string",
              "maxLength": 20000
            },
            "customerContact": {
              "type": "string",
              "maxLength": 20000
            },
            "businessName": {
              "type": "string",
              "maxLength": 20000
            },
            "businessAddress": {
              "type": "string",
              "maxLength": 20000
            },
            "businessContact": {
              "type": "string",
              "maxLength": 20000
            },
            "terms": {
              "type": "string",
              "maxLength": 20000
            },
